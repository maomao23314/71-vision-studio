{
  "name": "scut-71-vision-studio",
  "displayName": "SCUT-71 Vision Studio",
  "description": "智能车视觉仿真环境 —— 只写算法，其余交给环境",
  "version": "0.9.3",
  "publisher": "scut-racing",
  "license": "GPL-3.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Visualization"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onDebugResolve:scut71",
    "onStartupFinished"
  ],
  "files": [
    "out/**",
    "media/**",
    "templates/**",
    "sdk/**",
    "package.json",
    "README.md"
  ],
  "contributes": {
    "commands": [
      {
        "command": "scut71.doctor",
        "title": "环境自检",
        "category": "SCUT-71",
        "icon": "$(heart)"
      },
      {
        "command": "scut71.build",
        "title": "编译仿真程序",
        "category": "SCUT-71",
        "icon": "$(tools)"
      },
      {
        "command": "scut71.newProject",
        "title": "新建仿真工程",
        "category": "SCUT-71",
        "icon": "$(new-folder)"
      },
      {
        "command": "scut71.setupProject",
        "title": "配置本工程（填处理函数名）",
        "category": "SCUT-71",
        "icon": "$(settings-gear)"
      },
      {
        "command": "scut71.showLog",
        "title": "打开运行日志",
        "category": "SCUT-71",
        "icon": "$(output)"
      },
      {
        "command": "scut71.openSimView",
        "title": "打开仿真视图",
        "category": "SCUT-71",
        "icon": "$(device-camera)"
      },
      {
        "command": "scut71.bench",
        "title": "测速（同图重复 N 次取平均）",
        "category": "SCUT-71",
        "icon": "$(dashboard)"
      },
      {
        "command": "scut71.run",
        "title": "运行（连续跑 N 帧）",
        "category": "SCUT-71",
        "icon": "$(play)"
      },
      {
        "command": "scut71.debug",
        "title": "调试（F5）",
        "category": "SCUT-71",
        "icon": "$(debug-alt)"
      },
      {
        "command": "scut71.stop",
        "title": "停止",
        "category": "SCUT-71",
        "icon": "$(debug-stop)"
      },
      {
        "command": "scut71.selectVariables",
        "title": "选择要观察的变量",
        "category": "SCUT-71",
        "icon": "$(checklist)"
      },
      {
        "command": "scut71.prevPic",
        "title": "上一张图",
        "category": "SCUT-71",
        "icon": "$(chevron-left)"
      },
      {
        "command": "scut71.nextPic",
        "title": "下一张图",
        "category": "SCUT-71",
        "icon": "$(chevron-right)"
      },
      {
        "command": "scut71.openSettings",
        "title": "打开设置",
        "category": "SCUT-71",
        "icon": "$(settings-gear)"
      }
    ],
    "keybindings": [
      {
        "command": "scut71.build",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "!inDebugMode"
      },
      {
        "command": "scut71.stop",
        "key": "shift+f5",
        "mac": "shift+f5",
        "when": "view == scut71.simview"
      },
      {
        "command": "scut71.bench",
        "key": "f9",
        "mac": "f9",
        "when": "view == scut71.simview"
      },
      {
        "command": "scut71.prevPic",
        "key": "left",
        "mac": "left",
        "when": "view == scut71.simview"
      },
      {
        "command": "scut71.nextPic",
        "key": "right",
        "mac": "right",
        "when": "view == scut71.simview"
      },
      {
        "command": "scut71.run",
        "key": "f8",
        "mac": "f8",
        "when": "view == scut71.simview && !inDebugMode"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "scut71.build",
          "when": "view == scut71.simview",
          "group": "navigation@1"
        },
        {
          "command": "scut71.debug",
          "when": "view == scut71.simview",
          "group": "navigation@2"
        },
        {
          "command": "scut71.run",
          "when": "view == scut71.simview",
          "group": "navigation@3"
        },
        {
          "command": "scut71.bench",
          "when": "view == scut71.simview",
          "group": "navigation@4"
        },
        {
          "command": "scut71.prevPic",
          "when": "view == scut71.simview",
          "group": "navigation@5"
        },
        {
          "command": "scut71.nextPic",
          "when": "view == scut71.simview",
          "group": "navigation@6"
        },
        {
          "command": "scut71.stop",
          "when": "view == scut71.simview",
          "group": "navigation@7"
        }
      ],
      "editor/title": [
        {
          "command": "scut71.build",
          "when": "resourceLangId == c || resourceLangId == cpp",
          "group": "navigation@1"
        },
        {
          "command": "scut71.nextPic",
          "when": "resourceLangId == c || resourceLangId == cpp",
          "group": "navigation@3"
        }
      ],
      "editor/title/context": [
        {
          "command": "scut71.build",
          "when": "resourceLangId == c || resourceLangId == cpp",
          "group": "scut71@1"
        }
      ],
      "commandPalette": []
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "scut71",
          "title": "SCUT-71 Vision",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "scut71": [
        {
          "id": "scut71.simview",
          "name": "仿真",
          "type": "webview"
        }
      ]
    },
    "debuggers": [
      {
        "type": "scut71",
        "label": "SCUT-71 仿真调试",
        "languages": [
          "c",
          "cpp"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [],
            "properties": {
              "program": {
                "type": "string",
                "description": "要调试的可执行文件（留空则自动使用 .scut/bin/scut_sim.exe）"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "传给仿真程序的命令行参数"
              },
              "cwd": {
                "type": "string",
                "description": "工作目录（留空则用工程根目录）"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "scut71",
            "request": "launch",
            "name": "SCUT-71 仿真调试"
          }
        ],
        "configurationSnippets": [
          {
            "label": "SCUT-71: 调试仿真程序",
            "description": "调试 .scut/bin/scut_sim.exe（路径自动补齐，不需要手写）",
            "body": {
              "type": "scut71",
              "request": "launch",
              "name": "SCUT-71 仿真调试"
            }
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "c"
      },
      {
        "language": "cpp"
      }
    ],
    "configurationDefaults": {
      "C_Cpp.intelliSenseEngine": "disabled"
    },
    "configuration": {
      "title": "SCUT-71 Vision Studio",
      "properties": {
        "scut71.toolchain": {
          "type": "object",
          "title": "工具链",
          "description": "编译用的 LLVM-MinGW。多数人不需要改这里 —— 插件会自己探测，找不到时会弹窗问你。",
          "properties": {
            "scut71.toolchain.path": {
              "type": "string",
              "default": "",
              "description": "编译工具链根目录（里面应有 bin/clang.exe）。留空 = 依次探测：SCUT71_TOOLCHAIN 环境变量 → 插件下载过的目录 → PATH。都找不到时插件会弹窗问你要，可以指定已有目录或让它下载一份。"
            },
            "scut71.toolchain.autoDownload": {
              "type": "boolean",
              "default": true,
              "description": "允许在找不到工具链时下载一份精简版 LLVM-MinGW 到插件目录（约 165MB，只需一次）。默认开启，但下载前一定会先问你；已经装了工具链的话，请用上面的「工具链根目录」或让插件弹窗指定，不受影响。"
            },
            "scut71.toolchain.autoWatch": {
              "type": "boolean",
              "default": true,
              "description": "编译时自动发现全局变量（关闭可加快构建，但变量面板会是空的）"
            }
          }
        },
        "scut71.project": {
          "type": "object",
          "title": "工程配置",
          "description": "★ 这一组是编译期契约，改完需要重新编译。图像尺寸必须与 pic/ 里的测试图一致。",
          "properties": {
            "scut71.project.imageWidth": {
              "type": "number",
              "default": 188,
              "minimum": 1,
              "maximum": 4096,
              "markdownDescription": "图像宽度（像素）\n\n★ 这是编译期契约：C 语言里数组大小必须是常量，而算法里到处是 `int line[SCUT_IMAGE_H];`。改完需要**重新编译**。\n\n改这个值请同时确认 `pic/` 里的测试图尺寸一致，否则会被裁剪。"
            },
            "scut71.project.imageHeight": {
              "type": "number",
              "default": 120,
              "minimum": 1,
              "maximum": 4096,
              "markdownDescription": "图像高度（像素）\n\n★ 编译期契约，改完需要重新编译。说明同「图像宽度」。"
            },
            "scut71.project.inputArray": {
              "type": "string",
              "default": "mt9v03x_image",
              "markdownDescription": "输入图像数组名\n\n环境会提供一个**同名同形状、地址恒定**的全局数组，你的算法像在车上那样直接按名字读它即可。\n\n默认 `mt9v03x_image` 是车载库的惯例命名，所以**保持默认最省事**——你的算法代码一个字都不用改。\n\n★ 地址恒定很重要：逆透视这类「指向图像像素的指针表」靠它才能长期有效。"
            },
            "scut71.project.outputArray": {
              "type": "string",
              "default": "",
              "markdownDescription": "结果图数组名\n\n填你算法里存放结果图的数组名（例如 `binary_image`）。环境每帧把它**逐像素深拷贝**到显示缓冲。\n\n留空 = 画面显示输入图本身（看不到算法结果）。\n\n★ 为什么是深拷贝而不是换指针：算法里往往有指向图像像素的指针表（逆透视），换指针会让它们集体悬空——读到随机内存且不报错。"
            },
            "scut71.project.initFunctions": {
              "type": "string",
              "default": "",
              "editPresentation": "multilineText",
              "markdownDescription": "初始化函数**（开机调用一次，不计时）**\n\n填你代码里的函数名，每行一个，按顺序调用。例如：\n\n```\ncamera_init\n```\n\n★ 这些函数必须是**非 static** 的 `void f(void)`。这不是额外限制——车上 `main()` 要调用它们，本来就得如此。\n\n★ 你的代码里**不需要**写任何注册宏：调用关系留在环境侧，代码才能直接拷上车。"
            },
            "scut71.project.frameFunctions": {
              "type": "string",
              "default": "",
              "editPresentation": "multilineText",
              "markdownDescription": "图像处理函数**（每帧调用，★ 计时段）**\n\n填你算法的主入口函数名，每行一个。例如：\n\n```\nimage_process\n```\n\n「测速」按钮测的就是这一段的耗时，所以这里只放**真正的算法**——画图、打日志请填到下面的后处理里。"
            },
            "scut71.project.postFunctions": {
              "type": "string",
              "default": "",
              "editPresentation": "multilineText",
              "markdownDescription": "后处理函数**（每帧调用，不计时）**\n\n画调试标注、打日志这类**观测用**代码填这里。例如：\n\n```\ncamera_draw\ncamera_report\n```\n\n★ 为什么必须分开：放在处理函数里会把画图/打印的耗时算进「处理时间」，让性能数据失真（实测能虚高 8 倍）。"
            }
          }
        },
        "scut71.runtime": {
          "type": "object",
          "title": "运行期",
          "description": "这一组改完**立即生效**，不需要重新编译。多半不用动。",
          "properties": {
            "scut71.runtime.picDir": {
              "type": "string",
              "default": "",
              "description": "测试图集目录。留空 = 用工程里的 pic/1。"
            },
            "scut71.runtime.picExt": {
              "type": "string",
              "default": "",
              "description": "测试图后缀，逗号分隔多个按顺序优先匹配（例如 \".bmp,.png\"）。留空 = 默认 .bmp。支持 BMP 与 8 位 PNG。"
            },
            "scut71.runtime.startFrame": {
              "type": "number",
              "default": 1,
              "minimum": 0,
              "description": "从第几张图开始。0 起编号的图集（存在 0.bmp）可设 0。"
            },
            "scut71.runtime.processRepeat": {
              "type": "number",
              "default": 1,
              "minimum": 1,
              "description": "每帧重复调用图像处理的次数。设大（如 100）可抵消计时抖动，读到更稳定的平均耗时。"
            },
            "scut71.runtime.benchRepeat": {
              "type": "number",
              "default": 1000,
              "minimum": 1,
              "description": "「测速」按钮在同一张图上重复调用图像处理的次数。次数越大读数越稳，但等待越久。"
            },
            "scut71.runtime.runFrames": {
              "type": "number",
              "default": 60,
              "minimum": 1,
              "description": "「运行」按钮连续跑多少帧。它按图集顺序推进（与「测速」不同：测速是同一张图重复跑算法 N 次取平均耗时）。"
            }
          }
        },
        "scut71.view": {
          "type": "object",
          "title": "面板与显示",
          "description": "仿真面板各区块的显示方式。",
          "properties": {
            "scut71.view.showTiming": {
              "type": "boolean",
              "default": true,
              "description": "显示计时区块（处理/绘制耗时与 cycles）"
            },
            "scut71.view.showVariables": {
              "type": "boolean",
              "default": true,
              "description": "显示变量区块（勾选与查看）"
            },
            "scut71.view.showLog": {
              "type": "boolean",
              "default": true,
              "description": "显示日志区块"
            },
            "scut71.view.pickPersist": {
              "type": "boolean",
              "default": true,
              "description": "记住上次勾选了哪些变量（下次打开面板不用重新勾）"
            }
          }
        }
      }
    }
  },
  "scripts": {
    "sync-sdk": "node scripts/sync-sdk.js",
    "check-sdk": "node scripts/sync-sdk.js --check",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "prepackage": "npm run check-sdk",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^2.24.0"
  }
}
