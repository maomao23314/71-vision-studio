{
  "name": "scut-71-vision-studio",
  "displayName": "SCUT-71 Vision Studio",
  "description": "智能车视觉仿真环境 —— 只写算法，其余交给环境",
  "version": "0.10.2",
  "publisher": "scut-racing",
  "license": "GPL-3.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Visualization"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onDebugResolve:scut71",
    "onStartupFinished"
  ],
  "files": [
    "out/**",
    "media/**",
    "templates/**",
    "sdk/**",
    "package.json",
    "README.md",
    "LICENSE.md"
  ],
  "contributes": {
    "commands": [
      {
        "command": "scut71.doctor",
        "title": "环境自检",
        "category": "SCUT-71",
        "icon": "$(heart)"
      },
      {
        "command": "scut71.build",
        "title": "编译仿真程序",
        "category": "SCUT-71",
        "icon": "$(tools)"
      },
      {
        "command": "scut71.newProject",
        "title": "新建仿真工程",
        "category": "SCUT-71",
        "icon": "$(new-folder)"
      },
      {
        "command": "scut71.setupProject",
        "title": "配置本工程（填处理函数名）",
        "category": "SCUT-71",
        "icon": "$(settings-gear)"
      },
      {
        "command": "scut71.showLog",
        "title": "打开运行日志",
        "category": "SCUT-71",
        "icon": "$(output)"
      },
      {
        "command": "scut71.openSimView",
        "title": "打开仿真视图",
        "category": "SCUT-71",
        "icon": "$(device-camera)"
      },
      {
        "command": "scut71.bench",
        "title": "测速（同图重复 N 次取平均）",
        "category": "SCUT-71",
        "icon": "$(dashboard)"
      },
      {
        "command": "scut71.run",
        "title": "运行（连续跑 N 帧）",
        "category": "SCUT-71",
        "icon": "$(play)"
      },
      {
        "command": "scut71.debug",
        "title": "调试（F5）",
        "category": "SCUT-71",
        "icon": "$(debug-alt)"
      },
      {
        "command": "scut71.stop",
        "title": "停止",
        "category": "SCUT-71",
        "icon": "$(debug-stop)"
      },
      {
        "command": "scut71.selectVariables",
        "title": "选择要观察的变量",
        "category": "SCUT-71",
        "icon": "$(checklist)"
      },
      {
        "command": "scut71.prevPic",
        "title": "上一张图",
        "category": "SCUT-71",
        "icon": "$(chevron-left)"
      },
      {
        "command": "scut71.nextPic",
        "title": "下一张图",
        "category": "SCUT-71",
        "icon": "$(chevron-right)"
      },
      {
        "command": "scut71.gotoPic",
        "title": "跳到第 N 张图",
        "category": "SCUT-71",
        "icon": "$(go-to-file)"
      },
      {
        "command": "scut71.openSettings",
        "title": "打开设置",
        "category": "SCUT-71",
        "icon": "$(settings-gear)"
      }
    ],
    "keybindings": [
      {
        "command": "scut71.build",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "!inDebugMode"
      },
      {
        "command": "scut71.stop",
        "key": "shift+f5",
        "mac": "shift+f5",
        "when": "view == scut71.simview"
      },
      {
        "command": "scut71.bench",
        "key": "f9",
        "mac": "f9",
        "when": "view == scut71.simview"
      },
      {
        "command": "scut71.prevPic",
        "key": "left",
        "mac": "left",
        "when": "view == scut71.simview"
      },
      {
        "command": "scut71.nextPic",
        "key": "right",
        "mac": "right",
        "when": "view == scut71.simview"
      },
      {
        "command": "scut71.run",
        "key": "f8",
        "mac": "f8",
        "when": "view == scut71.simview && !inDebugMode"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "scut71.build",
          "when": "view == scut71.simview",
          "group": "navigation@1"
        },
        {
          "command": "scut71.debug",
          "when": "view == scut71.simview",
          "group": "navigation@2"
        },
        {
          "command": "scut71.run",
          "when": "view == scut71.simview",
          "group": "navigation@3"
        },
        {
          "command": "scut71.bench",
          "when": "view == scut71.simview",
          "group": "navigation@4"
        },
        {
          "command": "scut71.prevPic",
          "when": "view == scut71.simview",
          "group": "navigation@5"
        },
        {
          "command": "scut71.nextPic",
          "when": "view == scut71.simview",
          "group": "navigation@6"
        },
        {
          "command": "scut71.gotoPic",
          "when": "view == scut71.simview",
          "group": "navigation@7"
        },
        {
          "command": "scut71.stop",
          "when": "view == scut71.simview",
          "group": "navigation@8"
        }
      ],
      "editor/title": [
        {
          "command": "scut71.build",
          "when": "resourceLangId == c || resourceLangId == cpp",
          "group": "navigation@1"
        },
        {
          "command": "scut71.nextPic",
          "when": "resourceLangId == c || resourceLangId == cpp",
          "group": "navigation@3"
        }
      ],
      "editor/title/context": [
        {
          "command": "scut71.build",
          "when": "resourceLangId == c || resourceLangId == cpp",
          "group": "scut71@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "scut71",
          "title": "SCUT-71 Vision",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "scut71": [
        {
          "id": "scut71.simview",
          "name": "仿真",
          "type": "webview"
        }
      ]
    },
    "debuggers": [
      {
        "type": "scut71",
        "label": "SCUT-71 仿真调试",
        "languages": [
          "c",
          "cpp"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [],
            "properties": {
              "program": {
                "type": "string",
                "description": "要调试的可执行文件（留空则自动使用 .scut/bin/scut_sim.exe）"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "传给仿真程序的命令行参数"
              },
              "cwd": {
                "type": "string",
                "description": "工作目录（留空则用工程根目录）"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "scut71",
            "request": "launch",
            "name": "SCUT-71 仿真调试"
          }
        ],
        "configurationSnippets": [
          {
            "label": "SCUT-71: 调试仿真程序",
            "description": "调试 .scut/bin/scut_sim.exe（路径自动补齐，不需要手写）",
            "body": {
              "type": "scut71",
              "request": "launch",
              "name": "SCUT-71 仿真调试"
            }
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "c"
      },
      {
        "language": "cpp"
      }
    ],
    "configurationDefaults": {
      "C_Cpp.intelliSenseEngine": "disabled"
    }
  },
  "scripts": {
    "sync-sdk": "node scripts/sync-sdk.js",
    "check-sdk": "node scripts/sync-sdk.js --check",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "prepackage": "npm run sync-sdk && npm run compile",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^2.24.0"
  }
}
